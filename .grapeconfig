[project]
name=ALE

[repo]
name=grape
url=ssh://git@rz-stash.llnl.gov:7999/ale/grape.git
httpsbase=https://rzlc.llnl.gov/stash/scm/ale/
sshbase=ssh://git@rz-stash.llnl.gov:7999/ale/

[view]
alldirs: *
required: *

[patch]
tagprefix = bundled 
branches = develop master
describePattern = v*
branchMappings = develop:develop master:master

[post-commit]
autopush = True
cascade = master:develop 
