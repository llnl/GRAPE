[repo]
name = grape
url = ssh://git@rz-stash.llnl.gov:7999/grp/grape.git
httpsbase = https://rzlc.llnl.gov/stash/scm/grp/
sshbase = ssh://git@rz-stash.llnl.gov:7999/grp/

[subtrees]
mergepolicy = squash
names = stashy
pushonpublish = True

[workspace]
subprojecttype = subtree
managesubmodules = True
submoduletopicprefixmappings = ?:develop
submodulepublishpolicy = ?:merge
submodulepublicmappings = ?:master

[patch]
tagprefix = bundled
describepattern = v*
branches = develop master  master-cz
branchmappings = develop:develop master:master  master-cz:master-cz
branchtotagpatternmapping = ?:v*
submodulebranches = master
submodulebranchmappings = ?:?

[flow]
publishpolicy = ?:merge
publicbranches = master develop release
topicprefixmappings = hotfix:master feature:develop bugfix:develop internal_release:develop public_release:develop ?:develop
topicdestinationmappings = internal_release:master public_release:master-cz
topiccascadetick = internal_release:2 ?:1

[publish]
buildcmds = 
builddir = 
testcmds = ./grape test
testdir = ./
prepublishcmds = vine/gendocs.py README.md , git add README.md
prepublishdir = .
postpublishcmds = 
postpublishdir = 
tickversion = True
deletetopic = True
updatelog = UPDATE_LOG
logskipfirstlines = 0
logentryheader = <date> <user>\n<version>\nReviewers: <reviewers>\n
emailnotification = True
emailheader = <public> updated to <version>\nReviewers: <reviewers>\n
emailserver = nospam.llnl.gov
emailsendto = robinson96@llnl.gov
emailsubject = <public> updated to <version>
usestash = True
emailfooter = 
emailmaxfiles = 100

[post-commit]
autopush = True
cascade = None

[post-rebase]
submoduleupdate = False

[post-merge]
submoduleupdate = False

[post-checkout]
submoduleupdate = False
syncwithorigin = True

[view]
alldirs = *
required = *

[versioning]
file = vine/VERSION
updatetag = True
branchslotmappings = ?:3 master:2
branchsuffixmappings = ?:
branchtagsuffixmappings = ?:
prefix = v

[pre-push]

[pre-rebase]

[pre-commit]

[project]
name = GRP
stashurl = https://rzlc.llnl.gov/bitbucket
verifyssl = True

[subtree-stashy]
prefix = stashy
remote = ../stashy.git
topicprefixmappings = ?:grape

[nestedProjects]
names = subproject1

[walkthrough]
height = 400
width = 800
difftool = xxdiff

[nested-subproject1]
active = False
prefix = subs/subproject1
url = /tmp/bloss1/tmp49usicd4/testRepo2

