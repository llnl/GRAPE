[project]
name=ALE

[repo]
name=grape
url=ssh://git@rz-stash.llnl.gov:7999/ale/grape.git
httpsbase=https://rzlc.llnl.gov/stash/scm/ale/
sshbase=ssh://git@rz-stash.llnl.gov:7999/ale/

[view]
alldirs: *
required: *

[patch]
tagprefix = bundled 
branches = develop master ale3d ale3d_4_22
describePattern = v*
branchMappings = develop:develop master:master ale3d:ale3d ale3d_4_22:ale3d_4_22

[post-commit]
autopush = True
cascade = master:develop 

[post-rebase]
submoduleUpdate = True

[post-merge]
submoduleUpdate = True

[post-checkout]
submoduleUpdate = True

[flow]
publicBranches = master develop release ale3d
topicPrefixMappings = hotfix:master feature:develop bugfix:develop rc:release ?:develop


