[repo]
name = grape
url = ssh://git@rzgitlab.llnl.gov:7999/grp/grape.git
httpsbase = https://rzlc.llnl.gov/gitlab/grp/
sshbase = ssh://git@rzgitlab.llnl.gov:7999/grp/
ssh_pat_url = git@rzgitlab.llnl.gov
ssh_pat_port = 7999


[workspace]
managesubmodules = True
submoduletopicprefixmappings = ?:develop
submodulepublishpolicy = ?:merge

[patch]
tagprefix = bundled
describepattern = v*
branches = develop master  master-cz
branchmappings = develop:develop master:master  master-cz:master-cz

[flow]
#publishpolicy = ?:merge master:cascade->develop master-cz:cascade->master
publishpolicy = ?:merge
publicbranches = master develop release 
topicprefixmappings = hotfix:master feature:develop bugfix:develop internal_release:develop public_release:develop ?:develop
topicdestinationmappings = internal_release:master public_release:master-cz
topicCascadeTick = internal_release:2 ?:1

[publish]
mergetrain = True
buildcmds = 
builddir = 
testcijob = merge_train_ticket
testcmds = ./grape test
testdir = ./
prepublishcmds = vine/gendocs.py README.md , git add README.md
prepublishdir = .
postpublishcmds = 
postpublishdir = 
tickversion = True
deletetopic = True
updatelogdir = UPDATES_<major_version>.<minor_version>
updatelog = UPDATE_LOG
logskipfirstlines = 0
logentryheader = <date> <user>\n<version>\nReviewers: <reviewers>\n
emailnotification = True
emailheader = <public> updated to <version>\nReviewers: <reviewers>\n
emailserver = smtp.llnl.gov
emailsendto = robinson96@llnl.gov
emailsubject = <public> updated to <version>

[post-commit]
autopush = Topic
#cascade = master:develop

[post-rebase]
submoduleupdate = False

[post-merge]
submoduleupdate = False

[post-checkout]
submoduleupdate = False

[view]
alldirs = *
required = *

[versioning]
file = vine/VERSION
fileIsDerived = True
updatetag = True
branchslotmappings = ?:3
branchsuffixmappings = ?:
branchtagsuffixmappings = ?:
prefix = v


[pre-push]

[pre-rebase]

[pre-commit]

[project]
name = GRP
codeReviewsURL = https://rzlc.llnl.gov/gitlab

[subtree-stashy]
prefix = stashy
remote = ../stashy.git
topicprefixmappings = ?:grape

[concurrency-control]
defaultnumtasks = 8
exclusivenodenumtasks = -1
exclusivevarlist = SLURM_NODEID LLNL_COMPUTE_NODES

